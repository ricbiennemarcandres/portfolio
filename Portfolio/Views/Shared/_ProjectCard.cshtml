@model Project

<article class="project-card">
    <a class="project-cover" asp-area="" asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId">
        @if (Model.CoverImageUrl is not null)
        {
            <img src="@Model.CoverImageUrl" alt="Screenshot of @Model.Title" loading="lazy" />
        }
        else
        {
            <span class="cover-empty">no screenshots yet</span>
        }
        @if (Model.ImageCount > 1)
        {
            <span class="cover-count">@Model.ImageCount images</span>
        }
    </a>
    <div class="project-body">
        <a class="code-tag" asp-area="" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">@Model.CourseCode</a>
        <h3>
            <a asp-area="" asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId">@Model.Title</a>
        </h3>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@TextHelper.Shorten(Model.Description, 130)</p>
        }
        @if (Model.ToolList.Any())
        {
            <ul class="chips">
                @foreach (var tool in Model.ToolList)
                {
                    <li>@tool</li>
                }
            </ul>
        }
    </div>
</article>
