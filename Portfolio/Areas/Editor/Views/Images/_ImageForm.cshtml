@model ProjectImage

<div asp-validation-summary="ModelOnly" class="form-alert"></div>
<input type="hidden" asp-for="ImageId" />
<input type="hidden" asp-for="ProjectId" />

<div class="form-grid">
    <div class="field span-3">
        <label asp-for="ImageUrl"></label>
        <input asp-for="ImageUrl" class="form-control mono" spellcheck="false" data-preview="#image-preview"
               placeholder="https://xxxx.supabase.co/storage/v1/object/public/portfolio/screen1.png" />
        <small class="hint">A public https link ending in .png, .jpg, .jpeg, .gif, .webp or .svg.</small>
        <span asp-validation-for="ImageUrl" class="field-error"></span>
        <div id="image-preview" class="preview-strip" aria-live="polite"></div>
    </div>

    <div class="field span-2">
        <label asp-for="Caption"></label>
        <input asp-for="Caption" class="form-control" />
        <span asp-validation-for="Caption" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="SortOrder"></label>
        <input asp-for="SortOrder" class="form-control" type="number" min="1" max="999" />
        <span asp-validation-for="SortOrder" class="field-error"></span>
    </div>
</div>
