@model List<Course>
@{
    ViewData["Title"] = "Manage courses";
    var search = ViewData["Search"] as string;
}

<header class="page-head head-row">
    <div>
        <p class="eyebrow">Editor</p>
        <h1>Courses</h1>
    </div>
    <a class="btn-ink" asp-action="Create">+ Add a course</a>
</header>

<form class="search-bar" asp-action="Index" method="get" role="search">
    <input type="search" name="q" value="@search" placeholder="Search by code or title…" aria-label="Search courses" />
    <button type="submit" class="btn-ghost">Search</button>
</form>

@if (Model.Count == 0)
{
    <p class="empty">No courses. <a asp-action="Create">Add one.</a></p>
}
else
{
    <div class="table-wrap">
        <table class="ed-table">
            <thead>
                <tr><th>Code</th><th>Title</th><th>School year</th><th>Semester</th><th>Units</th><th>Projects</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><span class="code-tag">@c.Code</span></td>
                        <td>@c.Title</td>
                        <td class="mono">@c.SchoolYear</td>
                        <td>@c.SemesterName</td>
                        <td>@c.Units</td>
                        <td><a asp-controller="Projects" asp-action="Index" asp-route-courseId="@c.CourseId">@c.ProjectCount</a></td>
                        <td class="row-actions">
                            <a asp-action="Edit" asp-route-id="@c.CourseId">Edit</a>
                            <a asp-controller="Projects" asp-action="Create" asp-route-courseId="@c.CourseId">+ Project</a>
                            <a class="danger" asp-action="Delete" asp-route-id="@c.CourseId">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
